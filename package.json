  },
  "devDependencies": {
    "@types/chrome": "^0.2.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
